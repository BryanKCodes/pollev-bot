# Local NUS launcher settings. No passwords or saved browser profile needed.
LOGIN_TYPE=nus
POLLHOST=your-presenter-host
ANSWER_MODE=llm
ANSWER_THEME=
LIFETIME=3600
DURATION_UNIT=minutes
NUS_KEEP_BROWSER_OPEN=false
LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# Apple Silicon: -1 for Metal; other machines: 0 for CPU.
LLM_GPU_LAYERS=-1
